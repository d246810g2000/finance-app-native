# Preferred: let scripts/build-apk.sh create credentials/android-release.*
# Or copy these values to ~/.gradle/gradle.properties / CI secrets.
#
# RELEASE_STORE_FILE must be an absolute path (survives expo prebuild --clean).
RELEASE_STORE_FILE=/absolute/path/to/credentials/android-release.keystore
RELEASE_STORE_PASSWORD=replace-me
RELEASE_KEY_ALIAS=finance-release
RELEASE_KEY_PASSWORD=replace-me
